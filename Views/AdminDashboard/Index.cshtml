@{
    ViewData["Title"] = "Admin Dashboard";
}

<style>
    .stat-card {
        background: #fff;
        border-radius: 8px;
        box-shadow: 0 1px 2px rgba(0,0,0,0.1);
        padding: 24px;
        text-align: center;
    }

    .stat-number {
        font-size: 2rem;
        font-weight: bold;
        color: #1877f2;
    }

    .quick-links a {
        margin-right: 10px;
    }
</style>

<h2>Welcome, Admin!</h2>

<div class="row mt-4 g-3">
    <div class="col-md-2-4 col-6 col-md">
        <div class="stat-card">
            <div class="stat-number">@ViewBag.TotalUsers</div>
            <div class="text-muted">Total Users</div>
        </div>
    </div>
    <div class="col-md-2-4 col-6 col-md">
        <div class="stat-card">
            <div class="stat-number">@ViewBag.TotalEmployers</div>
            <div class="text-muted">Employers</div>
        </div>
    </div>
    <div class="col-md-2-4 col-6 col-md">
        <div class="stat-card">
            <div class="stat-number">@ViewBag.TotalJobSeekers</div>
            <div class="text-muted">Job Seekers</div>
        </div>
    </div>
    <div class="col-md-2-4 col-6 col-md">
        <div class="stat-card">
            <div class="stat-number">@ViewBag.TotalJobs</div>
            <div class="text-muted">Job Postings</div>
        </div>
    </div>
    <div class="col-md-2-4 col-6 col-md">
        <div class="stat-card">
            <div class="stat-number">@ViewBag.TotalApplications</div>
            <div class="text-muted">Applications</div>
        </div>
    </div>
</div>

<div class="quick-links mt-4">
    <a asp-action="Users" class="btn btn-primary">Manage Users</a>
    <a asp-action="Jobs" class="btn btn-outline-primary">Manage Jobs</a>
</div>