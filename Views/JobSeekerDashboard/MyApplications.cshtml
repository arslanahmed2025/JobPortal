@model List<JobPortal.Models.JobApplication>

@{
    ViewData["Title"] = "My Applications";
}

<style>
    .app-row {
        background: #fff;
        border-radius: 8px;
        box-shadow: 0 1px 2px rgba(0,0,0,0.1);
        padding: 18px;
        margin-bottom: 12px;
    }

    .status-badge {
        font-size: 0.8rem;
    }
</style>

<h2>My Applications</h2>
<a asp-action="Index" class="btn btn-outline-primary mb-3">Browse More Jobs</a>

@if (!Model.Any())
{
    <p class="text-muted">Aapne abhi tak kisi job pe apply nahi kiya.</p>
}
else
{
    foreach (var app in Model)
    {
        <div class="app-row d-flex justify-content-between align-items-center">
            <div>
                <h6 class="mb-1">@app.JobPosting.Title</h6>
                <p class="text-muted mb-0 small">
                    @app.JobPosting.EmployerProfile.CompanyName • Applied @app.AppliedDate.ToString("dd MMM yyyy")
                </p>
            </div>
            <span class="badge bg-secondary status-badge">@app.Status.ToString()</span>
        </div>
    }
}